{
  "name": "vswebapp",
  "version": "0.0.42",
  "description": "Secure ID Dashboard",
  "engines": {
    "node": ">=18.17.1",
    "npm": ">=9.6.7"
  },
  "config": {
    "unsafe-perm": true,
    "commitizen": {
      "path": "./vswebapp/node_modules/@digitalroute/cz-conventional-changelog-for-jira"
    }
  },
  "author": "Cashfree",
  "license": "MIT",
  "scripts": {
    "version": "echo $npm_package_version",
    "prebuild": "npm run build:clean",
    "postinstall": "cd ../.. && husky install apps/vswebapp/.husky",
    "build": "export NODE_ENV=development && webpack-cli --config webpack/webpack.dev.js",
    "build_dev": "export NODE_ENV=development && webpack-cli --config webpack/webpack.dev.js",
    "build_prod": "export NODE_ENV=prod && webpack --config webpack/webpack.prod.js",
    "build_qa": "export NODE_ENV=qa && webpack --config webpack/webpack.prod.js",
    "build-prod-vswebapp": "export NODE_ENV=prod && webpack --config webpack/webpack.prod.js",
    "build-qa-vswebapp": "export NODE_ENV=qa && webpack --config webpack/webpack.prod.js",
    "build-sbox-vswebapp": "export NODE_ENV=gamma && webpack --config webpack/webpack.dev.js",
    "build-prodint-vswebapp": "export NODE_ENV=prod-test &&  webpack --config webpack/webpack.prod.js",
    "build_prod-test": "export NODE_ENV=prod-test &&  webpack --config webpack/webpack.prod.js",
    "build_beta": "export NODE_ENV=beta && webpack --config webpack/webpack.dev.js",
    "build_gamma": "export NODE_ENV=gamma && webpack --config webpack/webpack.dev.js",
    "build:clean": "rimraf ./build",
    "commit": "git-cz",
    "format": "prettier --write \"**/*.+(js|jsx|ts|tsx|css|md)\"",
    "start": "export NODE_ENV=development && webpack-cli serve --config webpack/webpack.dev.js --open",
    "start:gamma": "export NODE_ENV=gamma && webpack-cli serve --config webpack/webpack.dev.js --open",
    "start:tunnel": "cross-env NODE_ENV=development node server",
    "start:production": "export NODE_ENV=prod && webpack-cli serve --config webpack/webpack.prod.js --open",
    "start:prod": "cross-env NODE_ENV=production node server",
    "start:dev": "cross-env NODE_ENV=development node server",
    "test": "cross-env NODE_ENV=test jest --coverage",
    "test:watch": "cross-env NODE_ENV=test jest --watchAll",
    "clear_jest": "cross-env NODE_ENV=test jest --clearCache",
    "lint": "NODE_ENV=development npm run lint:js && npm run lint:css",
    "lint:css": "stylelint app/**/*.js",
    "lint:js": "eslint app/",
    "lint:js:fix": "NODE_ENV=development eslint --fix app/",
    "prettify": "prettier --write app/**/*.js",
    "postbuild": "rimraf build/**/*.map"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "IE 10"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.js": [
      "eslint --fix",
      "prettier --write",
      "jest --bail --findRelatedTests",
      "git add --force"
    ]
  },
  "jest": {
    "verbose": true,
    "testTimeout": 60000,
    "testEnvironment": "jsdom",
    "roots": [
      "<rootDir>/app"
    ],
    "moduleDirectories": [
      "app",
      "node_modules"
    ],
    "testMatch": [
      "**/?(*.)+(test).js"
    ],
    "collectCoverageFrom": [
      "app/**/*.js",
      "!**/app/*.js",
      "!**/app/services/**",
      "!**/app/constants/**",
      "!**/app/redux/actions/**",
      "!**/app/components/IFrame/**",
      "!**/app/**/constants.js",
      "!**/app/containers/**/helpers.js",
      "!**/app/containers/**/utils.js",
      "!**/app/containers/**/styled.js",
      "!**/app/**/Loadable.js",
      "!**/app/global-styles.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "json",
      "clover",
      "json-summary"
    ],
    "moduleNameMapper": {
      ".*\\.(css)$": "<rootDir>/webpack/mocks/cssModule.js",
      ".*\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2)$": "<rootDir>/webpack/mocks/image.js"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/app/setupTests.js"
    ]
  },
  "resolutions": {
    "babel-core": "7.0.0-bridge.0"
  },
  "dependencies": {
    "@babel/polyfill": "^7.12.1",
    "@cashfree-intl/analytics": "3.0.0-development.17",
    "@cashfree-intl/auth": "2.0.0-development.20",
    "@cashfree-intl/coherent": "5.0.0-development.147",
    "@cashfree-intl/workflow": "2.0.0-globalstylecleanup.1",
    "@fingerprintjs/fingerprintjs": "^3.3.4",
    "@sentry/react": "^10.17.0",
    "amplitude-js": "^8.13.1",
    "axios": "^0.21.0",
    "bowser": "^2.11.0",
    "chalk": "^2.4.2",
    "classnames": "^2.2.6",
    "compression": "1.7.4",
    "cross-env": "5.2.0",
    "date-fns": "^2.14.0",
    "eventemitter3": "^4.0.7",
    "express": "4.16.4",
    "framer-motion": "^11.11.4",
    "history": "4.9.0",
    "ip": "1.1.9",
    "jest-canvas-mock": "^2.5.2",
    "lodash": "4.17.21",
    "minimist": "1.2.6",
    "moment": "^2.29.0",
    "prop-types": "15.7.2",
    "react": "18.2.0",
    "react-color": "^2.19.3",
    "react-confetti-explosion": "^2.1.2",
    "react-dom": "18.2.0",
    "react-gtm-module": "^2.0.11",
    "react-helmet": "^6.1.0",
    "react-joyride": "^2.7.2",
    "react-redux": "8.1.3",
    "react-router-dom": "^6.8.1",
    "recharts": "2.4.0",
    "redux": "4.0.1",
    "redux-thunk": "^2.3.0",
    "semantic-ui-react": "2.1.3",
    "styled-components": "^5.1.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@dashboard-monorepo/shared": "*",
    "@babel/cli": "7.4.3",
    "@babel/core": "7.4.3",
    "@babel/plugin-proposal-class-properties": "7.4.0",
    "@babel/plugin-syntax-dynamic-import": "7.2.0",
    "@babel/plugin-transform-modules-commonjs": "7.4.3",
    "@babel/plugin-transform-react-constant-elements": "7.2.0",
    "@babel/plugin-transform-react-inline-elements": "7.2.0",
    "@babel/preset-env": "7.4.3",
    "@babel/preset-react": "7.0.0",
    "@babel/register": "7.4.0",
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@digitalroute/cz-conventional-changelog-for-jira": "^7.3.1",
    "@playwright/test": "^1.57.0",
    "@sentry/webpack-plugin": "^2.14.0",
    "@testing-library/jest-dom": "6.1.5",
    "@testing-library/react": "14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/node": "^24.10.1",
    "add-asset-html-webpack-plugin": "6.0.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.0.1",
    "babel-loader": "8.0.5",
    "babel-plugin-dynamic-import-node": "2.2.0",
    "babel-plugin-lodash": "3.3.4",
    "babel-plugin-styled-components": "1.10.0",
    "babel-plugin-transform-react-remove-prop-types": "0.4.24",
    "circular-dependency-plugin": "5.0.2",
    "clean-webpack-plugin": "^4.0.0",
    "commitizen": "^4.2.5",
    "compare-versions": "3.4.0",
    "compression-webpack-plugin": "10.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "6.8.1",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^8.2.0",
    "dotenv-webpack": "^8.0.1",
    "eslint": "5.16.0",
    "eslint-config-airbnb": "17.1.0",
    "eslint-config-airbnb-base": "13.1.0",
    "eslint-config-prettier": "4.1.0",
    "eslint-import-resolver-webpack": "0.11.1",
    "eslint-plugin-import": "2.17.2",
    "eslint-plugin-jsx-a11y": "^6.4.1",
    "eslint-plugin-prettier": "3.0.1",
    "eslint-plugin-react": "7.12.4",
    "eslint-plugin-react-hooks": "1.6.0",
    "file-loader": "6.2.0",
    "html-loader": "0.5.5",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^8.0.1",
    "image-webpack-loader": "4.6.0",
    "imports-loader": "0.8.0",
    "jest": "28.1.1",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^13.0.0",
    "jest-styled-components": "7.1.1",
    "lint-staged": "8.1.5",
    "null-loader": "0.1.1",
    "pre-commit": "1.2.2",
    "prettier": "1.17.0",
    "puppeteer": "22.4.1",
    "react-app-polyfill": "0.2.2",
    "react-test-renderer": "18.0.0",
    "rimraf": "2.6.3",
    "standard-version": "^9.3.1",
    "style-loader": "0.23.1",
    "stylelint": "10.0.1",
    "stylelint-config-recommended": "2.2.0",
    "stylelint-config-styled-components": "0.1.1",
    "stylelint-processor-styled-components": "1.6.0",
    "svg-url-loader": "2.3.2",
    "terser-webpack-plugin": "5.3.9",
    "url-loader": "4.1.1",
    "webpack": "^5.74.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-middleware": "6.1.1",
    "webpack-dev-server": "^4.9.3",
    "webpack-hot-middleware": "2.24.3"
    
  }
}
